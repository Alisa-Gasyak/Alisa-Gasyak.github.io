# Многоступенчатая сборка
FROM python:3.11-slim AS builder

WORKDIR /app

# Установка зависимостей для сборки
RUN apt-get update && apt-get install -y \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Копирование protobuf файлов
COPY protos/ ./protos/

# Копирование зависимостей
COPY requirements.txt .

# Установка зависимостей
RUN pip install --no-cache-dir -r requirements.txt

# Генерация gRPC кода
RUN mkdir -p server/grpc_generated client/grpc_generated && \
    python -m grpc_tools.protoc \
      -I./protos \
      --python_out=./server/grpc_generated \
      --grpc_python_out=./server/grpc_generated \
      --python_out=./client/grpc_generated \
      --grpc_python_out=./client/grpc_generated \
      ./protos/glossary.proto

# Исправление импортов
RUN sed -i 's/import glossary_pb2 as glossary__pb2/from . import glossary_pb2 as glossary__pb2/' \
    server/grpc_generated/glossary_pb2_grpc.py && \
    sed -i 's/import glossary_pb2 as glossary__pb2/from . import glossary_pb2 as glossary__pb2/' \
    client/grpc_generated/glossary_pb2_grpc.py

# Финальный образ
FROM python:3.11-slim

WORKDIR /app

# Копирование зависимостей и сгенерированного кода
COPY --from=builder /usr/local/lib/python3.11/site-packages/ /usr/local/lib/python3.11/site-packages/
COPY --from=builder /app/server/grpc_generated/ ./server/grpc_generated/
COPY --from=builder /app/client/grpc_generated/ ./client/grpc_generated/

# Копирование исходного кода
COPY server/ ./server/
COPY client/ ./client/
COPY requirements.txt .

# Создание volume для данных
RUN mkdir -p /data
VOLUME /data

# Экспорт порта
EXPOSE 50051

# Команда запуска сервера
CMD ["python", "server/main.py"]